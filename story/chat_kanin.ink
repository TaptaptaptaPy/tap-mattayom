INCLUDE _shared.ink

// ไลน์ของกนิน — พิมพ์สั้น ไม่ใช้จุด ไม่ทักทาย เข้าเรื่องเลย
// เขาอยู่ร้านเกมตอนกลางคืน ข้อความเลยมักมาจากตรงนั้น

{ recalls("kanin") > 0:
    เขาพิมพ์ขึ้นมาลอยๆ ว่า {memoryOf("kanin")}
    แล้วค่อยพิมพ์ต่อว่าไม่มีอะไร แค่นึกขึ้นได้
}

{
    - rank < 2:  -> rank_0
    - rank < 4:  -> rank_1
    - else:      -> rank_2
}

=== rank_0 ===
ว่ะ
อยู่ร้านเกมอยู่ เครื่องที่สองว่าง

+ ["ดึกแล้วนะ พรุ่งนี้มีเรียน"]
    ~ gainAffinity("kanin", 1)
    เรียนมันก็มีทุกวันนั่นแหละ
    -> DONE

+ ["ไว้วันหลังละกัน"]
    ~ gainAffinity("kanin", 1)
    เออ
    (อ่านแล้ว 21:52)
    -> DONE

+ {nerve >= 5} ["รอเดี๋ยว กำลังหาทางออกจากบ้าน"]
    ~ gainStat("nerve", 2)
    ~ gainAffinity("kanin", 3)
    555
    เอาจริงดิ
    เออ ระวังแม่จับได้
    -> DONE

=== rank_1 ===
วันนี้ครูปกครองยืนดักหน้าประตูตั้งแต่เจ็ดโมงครึ่ง
พรุ่งนี้อย่ามาสาย

+ ["ขอบใจที่บอก"]
    ~ gainAffinity("kanin", 2)
    ไม่ได้บอกเพราะห่วงนะ
    แค่ไม่อยากโดนด่าคนเดียว
    -> DONE

+ ["แล้วนายล่ะ โดนไปกี่ครั้งแล้ว"]
    ~ gainAffinity("kanin", 1)
    ~ gainStat("nerve", 1)
    ไม่นับแล้ว
    -> DONE

// เมื่อวานหายไปไหน — ตอบได้สามแบบ และคำตอบถูกจดไว้ว่าบอกใครไปว่าอะไร
// ถ้าบอกคนที่เขาคุยกันไม่ตรงกัน วันหนึ่งมันจะไปเจอกันเอง
+ ["เมื่อวานติดอ่านหนังสือน่ะ"]
    ~ tellThem("yesterday", "busy")
    ~ gainAffinity("kanin", 1)
    เขาพิมพ์ว่า "ขยันจัง" แล้วก็ไม่ถามต่อ
    -> DONE
+ ["เมื่อวานไปกับอีกคน"]
    ~ tellThem("yesterday", "other")
    เขาพิมพ์ว่า "อ๋อ" แล้วเงียบไปพักหนึ่ง
    -> DONE
+ ["เมื่อวานไม่ไหวแล้วเลยนอน"]
    ~ tellThem("yesterday", "tired")
    ~ gainAffinity("kanin", 1)
    เขาพิมพ์ว่า "พักบ้างก็ดี" แล้วส่งรูปอะไรมาสักอย่าง
    -> DONE
+ {tomorrowSchool && plansBooked() > 0} [รับไว้ทั้งที่พรุ่งนี้มีนัดคนอื่นแล้ว]
    ~ inviteTomorrow("kanin")
    ~ gainAffinity("kanin", 3)
    เรารับปากไปทั้งที่รู้อยู่แก่ใจว่าพรุ่งนี้มีอีกคนรออยู่เหมือนกัน
    พรุ่งนี้จะมีใครสักคนยืนรอเก้อ และเราเป็นคนเลือกเองว่าใคร
    -> DONE
+ {tomorrowSchool} ["พรุ่งนี้เย็นไปสนามหลังตึกกันไหม"]
    ~ gainAffinity("kanin", 3)
    ~ inviteTomorrow("kanin")
    เออ
    กูอยู่ตรงนั้นทุกเย็นอยู่แล้ว
    มาก็มา ไม่มาก็ไม่ต้องบอก
    -> DONE

=== rank_2 ===
เห็นชื่อมึงในใบประกาศคะแนนสอบ
อยู่บนๆ ด้วย

+ ["ก็อ่านหนังสือมาบ้าง"]
    ~ gainAffinity("kanin", 1)
    -> follow

+ ["ทำไม อยากติวด้วยเหรอ"]
    ~ gainAffinity("kanin", 2)
    ~ gainStat("nerve", 1)
    -> follow

= follow
กูไม่เคยอยู่บนใบนั้นเลยสักครั้ง
ตั้งแต่ ม.4

+ ["ยังมีเวลาอีกตั้งเทอมนึง"]
    ~ gainAffinity("kanin", 2)
    ~ gainStat("kind", 1)
    พูดเหมือนครูเลย
    แต่เออ
    -> DONE

+ {kind >= 8} ["ไม่มีใครเคยถามนายเลยใช่ไหม ว่าทำไมถึงไม่อยู่บนใบนั้น"]
    ~ gainAffinity("kanin", 4)
    ~ setFlag("kanin_asked_why")
    มึงนี่
    { tomorrowSchool:
        พรุ่งนี้เย็นมาสนามหลังตึก
        จะเล่าให้ฟังครั้งเดียว
      - else:
        พรุ่งนี้โรงเรียนปิด ไว้วันเปิดเรียน
    }
    ++ {tomorrowSchool} ["ไปแน่"]
        ~ inviteTomorrow("kanin")
        ~ gainAffinity("kanin", 2)
        เออ
        -> DONE
    ++ ["พรุ่งนี้ไม่ว่าง ขอเป็นวันอื่น"]
        ~ gainAffinity("kanin", -2)
        ช่างมัน ลืมที่พูดไปเถอะ
        -> DONE

+ ["แล้วไง"]
    ~ gainAffinity("kanin", -1)
    ~ setHint("ถ้าน้ำใจถึง 8 จะมีคำถามที่ไม่มีใครเคยถามกนิน")
    เปล่า
    -> DONE
