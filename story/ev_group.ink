INCLUDE _shared.ink

// ประกาศงานกลุ่ม — จุดสำคัญคือ "ไม่ได้เลือกเอง"

ครูอ่านรายชื่อจับคู่จากกระดาษที่พิมพ์มาแล้ว
ไม่มีใครได้เลือก และไม่มีใครกล้าขอเปลี่ยน

+ [ฟังเฉยๆ แล้วไปคุยทีหลัง]
    ~ gainStat("mind", 1)
    ทั้งห้องเงียบไปพักหนึ่งหลังอ่านจบ แล้วก็เริ่มมีเสียงกระซิบ
    -> DONE

+ {nerve >= 8} ["ขอเปลี่ยนคู่ได้ไหมครับ"]
    ~ gainStat("nerve", 2)
    ~ standing(-3, "ขอเปลี่ยนคู่งานกลุ่มต่อหน้าทั้งห้อง")
    "ไม่ได้" ครูตอบโดยไม่เงยหน้า
    คนที่เราจับคู่ด้วยได้ยินทั้งห้องเหมือนกัน
    -> DONE

+ {kind >= 10} [เดินไปทักคู่ตัวเองก่อนหมดคาบ]
    ~ gainStat("kind", 3)
    ~ standing(3, "เดินไปทักคู่งานกลุ่มก่อนใคร")
    ~ setFlag("group_greeted")
    เขาดูตกใจที่มีคนเดินมาหาก่อน
    "เราไม่ค่อยได้ทำงานกลุ่มกับใคร" เขาบอก แล้วก็รีบแก้ "ไม่ใช่ว่าไม่ทำนะ"
    -> DONE
