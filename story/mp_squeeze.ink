INCLUDE _shared.ink

// องก์ 2 กลาง — "ครูเรียกไปคุยอีกรอบ" (วันที่ 84)
// ฉากนี้บอกผู้เล่นว่าเวลาเหลือน้อยลงแล้ว และบอกด้วยว่าตอนนี้เรารู้อะไรไปแล้วบ้าง
// บทเดียวกันแต่คนละน้ำเสียงทั้งหมด ขึ้นกับว่าครูสงสัยเราแค่ไหน

~ feel("firm")
ครูเรียกเราไปที่ห้องพักครูอีกรอบ คราวนี้ไม่มีคนอื่นต่อแถวอยู่ข้างนอก

{suspectLevel():
    - 2:
        ~ feel("angry")
        "ครูจะพูดตรงๆ" ครูพูดโดยไม่ให้เรานั่ง
        "ชื่อเธออยู่บนสุดของรายชื่อที่กรรมการจะเรียก และไม่ใช่เพราะเธอเรียนดี"
        ~ feel("firm")
        "สิ่งที่เธอทำมาทั้งเทอมมันพูดแทนเธอไปแล้ว ก่อนที่เธอจะได้พูดเองด้วยซ้ำ"
    - 1:
        ~ feel("think")
        "ชื่อเธอยังอยู่ในรายชื่อที่ครูต้องถามซ้ำ" ครูพูด
        "ไม่ใช่เพราะครูคิดว่าเป็นเธอ แต่เพราะครูยังตัดเธอออกไม่ได้"
    - else:
        ~ feel("calm")
        "ครูตัดเธอออกจากรายชื่อไปแล้ว" ครูพูด "เธอไม่ต้องกังวล"
        ~ feel("firm")
        "แต่ครูเรียกเธอมาเพราะอย่างอื่น"
}

~ feel("calm")
"อีกสามสัปดาห์กรรมการจะประชุม"
"ถ้าไม่มีใครพูดอะไร เรื่องจะจบแบบที่ทุกคนเดาไว้แล้ว"

{ plotClues() >= 3:
    ~ feel("think")
    เรารู้มากพอแล้วที่จะรู้ว่า "แบบที่ทุกคนเดาไว้" คืออะไร
    และรู้ด้วยว่ามันไม่ใช่เรื่องจริง
- else:
    ~ feel("away")
    เรายังไม่รู้ว่าคืนนั้นเกิดอะไรขึ้น รู้แค่ว่ามีคนหนึ่งกำลังจะรับไปคนเดียว
}

+ ["ถ้าผมรู้บางอย่าง ผมควรบอกครูไหมครับ"]
    ~ gainStat("mind", 1)
    ~ feel("sad")
    ครูเงียบไปนานกว่าที่ควรจะเงียบ
    "อย่าบอกครู" เขาพูดในที่สุด "บอกกรรมการ"
    ~ feel("firm")
    "ครูอยู่ในห้องนั้นด้วย และครูก็มีเจ้านายเหมือนกัน"
    ~ setFlag("mp_teacher_hint")
    -> DONE

+ ["ทำไมครูถึงบอกผมเรื่องนี้ครับ"]
    ~ gainStat("heart", 2)
    ~ feel("sad")
    "เพราะปีที่แล้วครูไม่ได้บอกใคร" ครูพูด
    "แล้วเด็กคนนั้นก็ไม่ได้เรียนต่อ"
    ~ setFlag("mp_teacher_regret")
    -> DONE

+ [ไม่ถามอะไร]
    ~ feel("away")
    เราพยักหน้ารับแล้วเดินออกมา
    ครูไม่ได้เรียกกลับ
    -> DONE
