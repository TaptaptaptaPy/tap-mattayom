INCLUDE _shared.ink

// ปลายทางของพลอย — อ่านจากทุกอย่างที่ผู้เล่นเลือกไว้ระหว่างเทอม

{
    - hasFlag("ploy_quit"):
        พลอยไม่ได้เป็นหัวหน้าห้องอีกแล้ว และไม่มีใครในห้องพูดถึงเรื่องนั้นอีกเลย
        เทอมถัดมาเธอนั่งแถวกลาง และเป็นคนแรกที่เก็บของกลับบ้านทุกวัน
    - hasFlag("ploy_stayed_on"):
        เธอยังเป็นหัวหน้าห้อง แต่ตารางในสมุดเหลือเจ็ดอย่างเหมือนที่เราขีดไว้ให้
        ครูถามว่าทำไมงานน้อยลง เธอตอบว่า "หนูทำเท่าที่ทำได้ค่ะ"
    - else:
        เธอยังทำทุกอย่างเหมือนเดิม และยังเป็นคนสุดท้ายที่ออกจากห้องสมุดทุกวัน
}

{
    - hasFlag("ploy_refused"):
        เรื่องคะแนนความประพฤติที่เธอไม่ยอมแก้ยังอยู่ในความทรงจำของครูคนนั้น
        แต่ก็อยู่ในความทรงจำของเด็กหลังห้องคนนั้นเหมือนกัน
    - hasFlag("ploy_complied"):
        คะแนนที่เธอแก้ไปไม่มีใครรู้ นอกจากเธอกับเรา
        และเธอไม่เคยเอ่ยถึงมันอีกเลยแม้แต่ครั้งเดียว
    - hasFlag("ploy_alone"):
        เธอตัดสินใจเรื่องนั้นคนเดียว และจำได้ว่าเราไม่ได้อยู่ตรงนั้น
}

{
    - hasFlag("ploy_stayed"):
        หลังวันที่เธอเป็นลมหน้าเสาธง เธอเริ่มกินข้าวเที่ยงจริงๆ ทุกวัน
        เพราะมีคนถามทุกวันว่ากินหรือยัง
    - hasFlag("ploy_called_mother"):
        แม่เธอโทรมาที่โรงเรียนเดือนละครั้งหลังจากนั้น ซึ่งมากกว่าเดิมสิบเท่า
        เธอไม่เคยขอบคุณเราเรื่องนั้น แต่ก็ไม่เคยโกรธอีกเลย
}

{
    - hasFlag("ploy_book"):
        สมุดเล่มที่สามถูกปิดไปแล้ว เธอเริ่มเล่มใหม่ที่หน้าแรกเขียนว่า
        "วันนี้มีคนถาม"
    - hasFlag("ploy_schedule"):
        เธอยังจดตารางที่บ้านอยู่ แต่ตอนนี้มีอีกคนที่รู้ว่าเธอจดอะไร
    - else:
        เรารู้จักเธอในฐานะหัวหน้าห้องที่เก่งมาก และไม่เคยรู้มากกว่านั้น
}

{ hasFlag("ploy_resigned"):
    ใบลาออกจากตำแหน่งหัวหน้าห้องมีชื่อเราอยู่ในช่องพยาน
    เป็นลายมือเดียวในเอกสารทั้งใบที่ไม่ใช่ของเธอ
}
{
    - hasFlag("ploy_sister_known"):
        เราเป็นคนเดียวที่เคยพูดถึงพี่สาวเธอแล้วเธอไม่เปลี่ยนเรื่อง
        ปีหน้าชื่อของพี่สาวจะยังอยู่บนกระดานเกียรติยศ และเธอก็ยังเดินผ่านมันทุกเช้า
    - hasFlag("ploy_sister_asked"):
        เรารู้ว่าพี่สาวเธอเรียนที่นี่ และรู้แค่นั้น
}
{ hasFlag("ploy_knows_pressure"):
    วันที่เราทักว่ามีคนบอกอะไรเธอมา เธอเงียบไปนาน
    หลังจากนั้นเวลามีใครสั่งอะไรแปลกๆ เธอจะเล่าให้เราฟังก่อนเสมอ
}
{ hasFlag("ploy_caught_error"):
    เวรวันนั้นไม่ใช่ของห้องเรา และเธอจำได้ว่าใครเป็นคนทัก
    ตั้งแต่นั้นเธอตรวจตารางเวรสองรอบทุกครั้ง
}

{
    - sidedWith("ploy") == 1:
        ตอนที่ต้องเลือก เราเลือกเธอ และเธอรู้
    - sideTaken() == 1:
        ตอนที่ต้องเลือก เราไม่ได้เลือกเธอ เธอไม่เคยพูดถึงเรื่องนั้น
        แต่เธอก็ไม่เคยขอให้เราเลือกอีกเลย
}

{
    - trust >= 4:
        เทอมถัดมาเธอส่งรูปสมุดหน้าใหม่มาให้ดูทางไลน์ โดยที่เราไม่ได้ขอ
        "อันนี้ของปีหน้า" เธอพิมพ์มา "ยังไม่มีอะไรในนั้นเลย"
    - trust >= 2:
        เธอยังทักเรามาบ้างเวลามีเรื่องที่ไม่รู้จะเล่าให้ใครฟัง
    - else:
        เรารู้จักเธอมากพอจะทักทาย แต่ไม่เคยมากพอจะให้เธอเล่าอะไรจริงๆ
}

{ hasFlag("ploy_alone_load"):
    ช่วงที่เราหายไป เธอรับงานของห้องเพิ่มโดยไม่บอกใคร และไม่เคยเอ่ยถึงมันอีก
}
{ hasFlag("ploy_alone_sick"):
    ช่วงที่เราหายไป เธอไม่มาโรงเรียนสองวัน และเราไม่ได้เป็นคนที่รู้ก่อนใคร
}

{ hasFlag("ploy_slipped"):
    ชื่อของเขาร่วงลงบนกระดานหน้าห้องรอบหนึ่ง และเราเป็นคนที่รู้ว่าทำไม
}
{ hasFlag("lifted_ploy"):
    คืนที่เราติวให้ก่อนสอบ กลายเป็นอันดับที่ขยับขึ้นจริงบนกระดานที่ทุกคนอ่าน
}
{ hasFlag("beat_ploy"):
    ครั้งที่ชื่อเราอยู่เหนือชื่อเธอบนกระดาน เธอไม่ได้พูดถึงมันเลยสักครั้ง
    แต่อาทิตย์นั้นเธอมาถึงห้องก่อนเราทุกวัน
}
{
    - hasFlag("milestone_won"):
    รอบชิง เธอกดออดก่อนแล้วหันมาดูเราเพื่อให้แน่ใจว่าเราจำคำตอบได้
    เราจำได้
    - hasFlag("milestone_flopped"):
    รอบแรกเราตอบผิดข้อที่เธอติวให้ตอนพักเที่ยงสามรอบ
    เธอบอกว่า "ไม่เป็นไร" ด้วยน้ำเสียงที่แปลว่าเป็นไร
}

{
    - hasFlag("let_them_go"):
    ตอนที่เราบอกว่าดีใจด้วย เธอมองหน้าเรานานกว่าที่ควรจะมอง
    - hasFlag("rival_ploy_ahead"):
    ปีนั้นฟ้ามาติวให้เธอทุกวันพุธ และเราเป็นคนที่รู้เรื่องนั้นทีหลังสุด
}

// ครั้งแรกที่เจอกัน — ธงจาก story/meet_ploy.ink
// ความประทับใจแรกไม่ได้หายไป มันแค่ถูกทับด้วยอีกร้อยวันที่ตามมา
{
    - hasFlag("meet_ploy_sharp"):
    เธอเคยบอกทีหลังว่าวันแรกที่เจอกัน เราเป็นคนแรกในรอบสามเดือนที่ถามว่าสมุดกองนั้นคืออะไร
    - hasFlag("meet_ploy_open"):
    "วันแรกเธอถามว่าที่นี่มีคนนั่งไหม" เธอบอก "ฉันตอบว่าไม่มี แล้วก็นึกเสียดายทั้งคืน"
    - hasFlag("meet_ploy_quiet"):
    วันแรกเราไม่ได้พูดอะไรเลย และเธอบอกว่านั่นแหละคือเหตุผลที่เธอยอมให้นั่ง
    - hasFlag("meet_ploy_cold"):
    วันแรกที่เจอกันเราถามผิดคำถาม และเธอจำคำถามนั้นได้แม่นกว่าที่เราจำ
}
{ hasFlag("meet_ploy_again"):
    "พรุ่งนี้อยู่ตรงนี้อีกไหม" — คำถามของวันแรก กลายเป็นคำถามที่เราถามกันอีกหลายสิบครั้ง
}

-> DONE
