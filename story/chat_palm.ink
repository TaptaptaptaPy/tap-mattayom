INCLUDE _shared.ink

// ไลน์ของปาล์ม — พิมพ์สุภาพเกินไป ลงท้ายครับทุกประโยค และมักลบข้อความก่อนส่ง

{ hasFlag("noticed_together"):
    "เมื่อวานผมอยู่โต๊ะข้างๆ นะครับ" เขาพิมพ์ "พี่คงไม่เห็น"
}

// คนอื่นก็ใช้เวลากับเขาเหมือนกัน — วันที่เราไม่ไป เขาไป
{ rivalLead() <= -12:
    "{rivalName()}นั่งข้างผมทั้งปีเลยครับ" เขาพิมพ์ "คุยกันรู้เรื่องดี"
}

// เขาเห็นว่าเราฝืนมา — ระบบหนี้การนอนต้องมีคนพูดถึง ไม่งั้นมันเป็นแค่ตัวเลขหลังบ้าน
{
    - hasFlag("fell_sick"):
    "พี่หายดีหรือยังครับ" เขาพิมพ์ แล้วพิมพ์ต่อว่า "ผมถามเมื่อวานด้วยแต่ลบทิ้ง"
    - hasFlag("dozed_in_class"):
    "ผมเห็นพี่หลับ" เขาพิมพ์ "ผมนั่งบังให้แล้วนะครับ"
    - hasFlag("pushed_through"):
    "พี่ครับ พี่นอนบ้างนะครับ" เขาพิมพ์มาตอนห้าทุ่มครึ่ง
}

// เขามองคนอื่นอยู่เงียบๆ มาทั้งเทอม และเห็นว่าใครไว้ใจเราบ้าง
{ trustOf("kanin") >= 3:
    "พี่กนินพูดถึงพี่บ่อยนะครับ" เขาพิมพ์ "แบบที่ไม่ได้พูดถึงคนอื่น"
- else:
    { trustOf("ploy") >= 3:
        "พี่พลอยฝากถามว่าพี่ส่งงานหรือยัง" เขาพิมพ์ "เขาถามผมแทนที่จะถามพี่เอง"
    }
}

{ recalls("palm") > 0:
    เขาพิมพ์ขึ้นมาว่า {memoryOf("palm")}
    แล้วพิมพ์ต่อว่า "ขอโทษครับ ไม่มีอะไรเลยจริงๆ"
}

{
    - rank < 3:  -> rank_0
    - else:      -> rank_1
}

=== rank_0 ===
สวัสดีครับพี่
(พิมพ์อยู่...)
เปล่าครับ ไม่มีอะไร


// คำขอเป็นของเขา ไม่ใช่ของเรา — ฟองซ้ายคือเขา ทางเลือกข้างล่างคือสิ่งที่เราพิมพ์ตอบ
{ examSoon && tutoredTimes() == 0:
    พี่ครับ
    ผมไม่เข้าใจอะไรเลยสักอย่าง
    ถามได้ไหมครับ
}

+ {rivalLead() <= -12} ["ดีใจด้วยนะ" — ยินดีกับเขาไปตรงๆ]
    ~ letThemGo()
    ~ gainStat("kind", 3)
    "ดีแล้วครับ" เราพิมพ์ไป
    เขาส่งสติกเกอร์มาอันหนึ่งแล้วออฟไลน์ไป
    -> DONE
+ ["มีอะไรก็บอกได้นะ"]
    ~ gainAffinity("palm", 3)
    ~ gainStat("kind", 1)
    ครับ
    ...
    พรุ่งนี้พี่ไปโรงอาหารกี่โมงครับ
    -> DONE

// เมื่อวานหายไปไหน — ตอบได้สามแบบ และคำตอบถูกจดไว้ว่าบอกใครไปว่าอะไร
// ถ้าบอกคนที่เขาคุยกันไม่ตรงกัน วันหนึ่งมันจะไปเจอกันเอง
+ ["เมื่อวานติดอ่านหนังสือน่ะ"]
    ~ tellThem("yesterday", "busy")
    ~ gainAffinity("palm", 1)
    เขาพิมพ์ว่า "ขยันจัง" แล้วก็ไม่ถามต่อ
    -> DONE
+ ["เมื่อวานไปกับอีกคน"]
    ~ tellThem("yesterday", "other")
    เขาพิมพ์ว่า "อ๋อ" แล้วเงียบไปพักหนึ่ง
    -> DONE
+ ["เมื่อวานไม่ไหวแล้วเลยนอน"]
    ~ tellThem("yesterday", "tired")
    ~ gainAffinity("palm", 1)
    เขาพิมพ์ว่า "พักบ้างก็ดี" แล้วส่งรูปอะไรมาสักอย่าง
    -> DONE
+ {tomorrowSchool && plansBooked() > 0} [รับไว้ทั้งที่พรุ่งนี้มีนัดคนอื่นแล้ว]
    ~ inviteTomorrow("palm")
    ~ gainAffinity("palm", 3)
    เรารับปากไปทั้งที่รู้อยู่แก่ใจว่าพรุ่งนี้มีอีกคนรออยู่เหมือนกัน
    พรุ่งนี้จะมีใครสักคนยืนรอเก้อ และเราเป็นคนเลือกเองว่าใคร
    -> DONE
// ติวให้กันก่อนสอบ — ราคาคือเวลาทบทวนของเราเอง ผลไปโผล่บนกระดานหน้าห้องรอบหน้า
// โผล่เฉพาะตอนสอบใกล้ ไม่งั้นมันเป็นแค่ปุ่มกดฟรี
+ {examSoon && tutoredTimes() == 0} ["ถามมาเลย ถามได้ทุกข้อ"]
    ~ tutorThem()
    ~ gainStat("kind", 1)
    เขาถามคำถามที่ควรถามตั้งแต่เดือนที่แล้ว
    เราตอบไปทีละข้อจนเขาเงียบ แล้วพิมพ์ว่า "อ๋อ แค่นี้เองเหรอ"
    -> DONE
+ {examSoon && tutoredTimes() == 0} ["คืนนี้พี่ไม่ไหวจริงๆ ขอโทษนะ"]
    ~ setHint("ติวให้เขาได้ แต่เวลาทบทวนของเราจะหายไปส่วนหนึ่ง")
    เราพิมพ์ว่าคืนนี้ไม่ไหวจริงๆ แล้ววางโทรศัพท์ลง
    หนังสือของเราเองยังเปิดค้างอยู่หน้าเดิม
    -> DONE
+ {tomorrowSchool} ["พรุ่งนี้เที่ยงเจอกันที่โรงอาหารนะ"]
    ~ gainAffinity("palm", 4)
    ~ inviteTomorrow("palm")
    ครับ!
    ผมจะไปนั่งรอที่โต๊ะเดิมนะครับ
    -> DONE

+ ["โอเค"]
    ~ gainAffinity("palm", -1)
    ครับ
    (อ่านแล้ว 21:03)
    -> DONE

=== rank_1 ===
พี่ครับ
ถ้าคนเราย้ายโรงเรียนสองรอบ มันแปลว่าเป็นที่เราใช่ไหมครับ

+ ["ไม่ใช่"]
    ~ gainAffinity("palm", 5)
    ~ gainStat("kind", 2)
    ~ setFlag("palm_asked")
    ครับ
    แม่ก็พูดแบบนี้
    แต่แม่ต้องพูดแบบนี้อยู่แล้วนี่ครับ
    -> DONE

+ {kind >= 16} ["ที่โรงเรียนเก่าน้องเคยถามคำนี้กับใครไหม"]
    ~ gainAffinity("palm", 6)
    ~ gainStat("mind", 2)
    ~ setFlag("palm_asked")
    ...
    ไม่เคยครับ
    ไม่มีใครให้ถาม
    -> DONE

+ {tomorrowSchool} ["พรุ่งนี้คุยกันดีกว่า ไม่ใช่เรื่องที่ควรพิมพ์"]
    ~ gainAffinity("palm", 4)
    ~ inviteTomorrow("palm")
    ครับ
    ขอบคุณครับพี่
    -> DONE
