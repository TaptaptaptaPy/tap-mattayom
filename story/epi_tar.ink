INCLUDE _shared.ink

// ปลายทางของพี่ต้าร์ — รุ่นพี่ปีสี่ที่กำลังจะไม่ได้เป็นรุ่นพี่อีกแล้ว

{
    - hasFlag("tar_key"):
        กุญแจห้องชุมนุมอยู่ในมือเราตั้งแต่วันที่เขาส่งให้
        เขากลับมาดูสองครั้งในปีนั้น ครั้งแรกเพราะห่วง ครั้งที่สองเพราะคิดถึง
    - hasFlag("tar_quit"):
        เขาไม่ได้พูดว่าจะลาออกอีกเลยหลังคืนนั้น
        แต่ก็ไม่เคยพูดว่าจะไม่ลาออกเหมือนกัน
    - else:
        เขาส่งมอบห้องชุมนุมให้รุ่นสามคนหนึ่ง แล้วก็ไม่ได้กลับมาอีก
}

{
    - hasFlag("tar_repeat") && hasFlag("tar_grades"):
        ใบเกรดใบนั้นเราเป็นคนเดียวที่เคยเห็น
        ปีนั้นเขาลงเรียนซ้ำสองตัว แล้วผ่านทั้งสองตัว
        "ไม่ได้เก่งขึ้นหรอก" เขาบอก "แค่มีคนรู้แล้วก็เลยโกหกตัวเองไม่ได้"
    - hasFlag("tar_repeat"):
        เรารู้ว่าเขาตกปีสอง และเขารู้ว่าเรารู้
        เท่านั้นก็เปลี่ยนวิธีที่เขาพูดกับเราไปตลอดทั้งปี
    - hasFlag("tar_grades"):
        เขาเอาใบเกรดให้เราดูครั้งเดียวแล้วเก็บเข้าลิ้นชักไปเลย
}

{
    - hasFlag("tar_home"):
        เขากลับบ้านครั้งแรกในรอบปีตอนปิดเทอม
        เขาไม่ได้เล่าว่าที่บ้านพูดอะไรบ้าง บอกแค่ว่า "ก็ไปแล้วแหละ"
}

{
    - sidedWith("tar") == 1:
        ตอนที่ต้องเลือกข้าง เราเลือกเขา ทั้งที่เขาเป็นฝ่ายผิดในสายตาคนอื่น
        เขาไม่เคยลืมเรื่องนั้น
    - sideTaken() == 1:
        ตอนที่ต้องเลือกข้าง เราไม่ได้เลือกเขา
        เขาบอกว่า "ถูกแล้ว" ด้วยน้ำเสียงที่ทำให้เราไม่แน่ใจว่าถูกจริงไหม
}

{
    - trust >= 4:
        เขาบอกเราเรื่องที่ยังไม่ได้บอกที่บ้าน แล้วขอให้เก็บไว้ก่อน — เราเก็บไว้จริง
    - trust >= 2:
        เขายังชวนเรากินข้าวบ้างเวลาว่าง แต่คุยแต่เรื่องชมรม
    - else:
        เขาเป็นรุ่นพี่ที่เราเคารพ และเท่านั้น
}

{ hasFlag("tar_alone_skip"):
    สัปดาห์ที่เขาไม่มาชมรมเลย ห้องนั้นว่างทั้งสัปดาห์
}
{ hasFlag("tar_alone_drop"):
    วิชาที่เขาถอนไปอีกตัว เขาไม่ได้บอกใครสักคน
}

{ hasFlag("tar_slipped"):
    ชื่อของเขาร่วงลงบนกระดานหน้าห้องรอบหนึ่ง และเราเป็นคนที่รู้ว่าทำไม
}
{ hasFlag("lifted_tar"):
    คืนที่เราติวให้ก่อนสอบ กลายเป็นอันดับที่ขยับขึ้นจริงบนกระดานที่ทุกคนอ่าน
}
{ hasFlag("beat_tar"):
    ครั้งที่ชื่อเราอยู่เหนือชื่อเขาบนกระดาน เขาพูดว่า "ดีแล้ว" แล้วไม่พูดต่อ
}
{
    - hasFlag("let_them_go"):
    เขาบอกว่าไม่ค่อยมีรุ่นน้องคนไหนพูดแบบนั้นได้
    - hasFlag("rival_tar_ahead"):
    ปีนั้น{rivalName()}กลับมา และวงคุยของเขาก็ไม่มีที่ให้เราอีก
}

// ครั้งแรกที่เจอกัน — ธงจาก story/meet_tar.ink
{
    - hasFlag("meet_tar_sharp"):
    "น้องถามว่าพี่ปีไหน" เขายังพูดถึงเรื่องนี้อยู่เลยตอนปลายเทอม "สองปีไม่มีใครกล้าถาม"
    - hasFlag("meet_tar_open"):
    วันแรกเขาทักเราก่อนที่เราจะทันพูดอะไร ซึ่งเป็นสิ่งที่เขาทำกับทุกคน
    แต่คนที่ตอบกลับจริงๆ มีไม่เยอะ
    - hasFlag("meet_tar_quiet"):
    วันแรกเราเดินเข้าไปนั่งเองโดยไม่ต้องให้ใครชวน เขาจำภาพนั้นได้
    - hasFlag("meet_tar_cold"):
    วันแรกเราบอกว่าจะไปก่อน แล้วเขาก็หันไปหาคนถัดไปตั้งแต่เรายังไม่พ้นประตู
}
{ hasFlag("meet_tar_again"):
    "มาจริงๆ นะ ไม่ใช่พูดเฉยๆ" — เขาพูดประโยคนี้กับทุกคน แต่เราเป็นคนที่มาจริง
}

-> DONE
