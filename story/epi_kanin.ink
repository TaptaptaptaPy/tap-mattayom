INCLUDE _shared.ink

// ปลายทางของกนิน

{
    - hasFlag("kanin_cleared"):
        ชื่อของกนินหายออกจากสมุดฝ่ายปกครองแล้ว
        เขาเดินเข้าห้องเรียนทางประตูหน้าทุกวันตั้งแต่นั้น แต่ยังนั่งที่เดิม
        "กูชอบที่นั่งนี้" เขาบอก "ไม่ได้ชอบเพราะมันหลังห้อง"
    - hasFlag("kanin_kept"):
        เขาเลือกเก็บเรื่องนั้นไว้เหมือนเดิม และอีกปีเดียวก็จบ
        คนที่ควรโดนยังอยู่บนกระดานหน้าห้อง และเขาก็ยังอยู่หลังห้อง
    - hasFlag("kanin_truth"):
        เรารู้ว่าทำไมเขาถึงโดนหมายหัว และเราเป็นคนเดียวที่รู้
    - else:
        เรารู้จักเขาในฐานะเด็กหลังห้องที่โดนหมายหัว และไม่เคยรู้ว่าทำไม
}

{
    - hasFlag("kanin_brother"):
        ซองบุหรี่ของพี่ชายยังอยู่ใต้อิฐหลวมๆ ตรงกำแพงหลังโรงอาหาร
        เขายังไม่เคยสูบสักมวน และยังไม่ทิ้ง
    - hasFlag("kanin_wall"):
        รอยขีดบนกำแพงหลังโรงอาหารหยุดอยู่ที่ตัวเลขหนึ่ง
        เขาไม่ได้ขีดต่ออีกเลยหลังจากวันที่มีคนมานั่งข้างๆ
}

{
    - hasFlag("kanin_book"):
        ในสมุดของเขามีรายชื่อคณะที่ยังขีดฆ่าไม่หมด และมีสองบรรทัดที่วงไว้
        เขาเริ่มมานั่งห้องสมุดสัปดาห์ละสองวัน ซึ่งไม่มีใครในห้องเชื่อเวลาเราเล่า
    - hasFlag("kanin_asked_why"):
        เขาเคยเล่าให้เราฟังครั้งเดียว แล้วไม่เคยเล่าซ้ำ
        แต่ก็ไม่เคยปฏิเสธว่าเคยเล่า
}

{ hasFlag("kanin_shop"):
    ร้านที่บ้านเขายังเปิดอยู่ และเรายังรู้ทางไป
    เจ้าของร้านจำหน้าเราได้ก่อนจำชื่อ และเรียกเราว่า "เพื่อนกนิน" ทุกครั้ง
}
{ hasFlag("kanin_witness"):
    ไม่มีรอบหน้าเกิดขึ้นจริงๆ แต่คำว่า "กูเป็นพยานให้" เขาจำได้ทั้งประโยค
    เขาบอกทีหลังว่านั่นเป็นครั้งแรกที่มีคนพูดแบบนั้นกับเขา
}
{ hasFlag("kanin_sat"):
    วันที่เรานั่งลงข้างๆ โดยไม่พูดอะไรเลย เขานับว่าเป็นวันที่เราเริ่มรู้จักกันจริงๆ
    ไม่ใช่วันที่ครูจับให้นั่งโต๊ะเดียวกัน
}

{
    - sidedWith("kanin") == 1:
        ตอนที่ต้องเลือก เราเลือกเขา
        เขาไม่เคยพูดขอบคุณ แต่เขาเริ่มเรียกชื่อเราแทนที่จะเรียกว่า "มึง"
    - sideTaken() == 1:
        ตอนที่ต้องเลือก เราไม่ได้เลือกเขา
        เขาเข้าใจ และนั่นแหละคือส่วนที่แย่ที่สุด
}

{
    - trust >= 4:
        เขาฝากกุญแจบ้านไว้กับเราหนึ่งดอก ไม่ได้บอกเหตุผล และเราไม่ได้ถาม
    - trust >= 2:
        เขายังทักเราก่อนเวลาเจอกันที่ไหนสักแห่ง ซึ่งเขาไม่ทำกับคนอื่น
    - else:
        เขาไม่เคยเล่าอะไรให้เราฟังจริงๆ สักเรื่อง และเราก็ไม่เคยถาม
}

{ hasFlag("kanin_alone_called"):
    ครั้งที่เขาโดนเรียกเข้าฝ่ายปกครองโดยไม่มีพยาน เขาไม่เคยเล่าให้เราฟัง
}
{ hasFlag("kanin_alone_gone"):
    สามวันที่เขาหายไป ไม่มีใครรู้ว่าเขาไปไหน รวมทั้งเรา
}
-> DONE
