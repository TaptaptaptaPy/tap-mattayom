INCLUDE _shared.ink

// ครั้งแรกที่ได้คุยกับปาล์ม — เขาย้ายมากลางเทอมและยังไม่พูดกับใครเลยสักคน
// ชุดธงเดียวกัน อ่านที่ story/epi_palm.ink

{background():
    - "transfer":  -> as_transfer
    - else:        -> stranger
}

=== stranger ===
โต๊ะริมสุดของโรงอาหารมีคนนั่งอยู่คนเดียว กินข้าวช้ามากเหมือนตั้งใจให้มันนานกว่านี้
เขาเห็นเราเดินมาแล้วขยับถาดเข้าหาตัวเองโดยไม่ได้ตั้งใจ

+ ["นั่งด้วยได้ไหม"]
    ~ gainStat("kind", 2)
    ~ gainAffinity("palm", 2)
    ~ setFlag("meet_palm_open")
    ~ feel("shy")
    เขาเงยหน้าขึ้นมาแบบคนที่ไม่ได้เตรียมคำตอบไว้
    "…ได้ครับ" เสียงเบามาก
    ~ introduce("palm")
    "ปาล์ม ม.4 ครับ" เขาบอกชื่อโดยที่เราไม่ได้ถาม เหมือนซ้อมประโยคนี้ไว้นานแล้ว
    -> after

+ [นั่งโต๊ะข้างๆ ไม่รบกวนเขา]
    ~ setFlag("meet_palm_quiet")
    เรานั่งห่างไปหนึ่งโต๊ะ เขาไม่ได้มองมา แต่กินเร็วขึ้นกว่าเดิมนิดหนึ่ง
    ตอนลุก เขาเดินผ่านแล้วหยุด
    ~ introduce("palm")
    "ปาล์มครับ" เขาพูดเร็วมาก แล้วก็เดินออกไปก่อนที่เราจะตอบ
    -> after

+ {kind >= 5} ["โต๊ะนี้ลมแรงนะ ย้ายไปตรงในกันไหม"]
    ~ gainStat("kind", 1)
    ~ gainAffinity("palm", 3)
    ~ setFlag("meet_palm_sharp")
    ~ feel("shock")
    เขาหยุดกินแล้วมองเรานานกว่าที่คนเพิ่งเจอกันจะมองกัน
    "…พี่รู้ได้ไงว่าผมหนาว"
    ~ introduce("palm")
    "ปาล์มครับ" เขาลุกตามมาโดยไม่ต้องให้ชวนซ้ำ
    -> after

+ {kind < 5} [ยืนดูอยู่ห่างๆ]
    ~ setHint("น้ำใจ 5 จะเห็นว่าทำไมเขาถึงเลือกโต๊ะนั้น")
    เขากินจนหมดแล้วเก็บถาดไปเอง ไม่มีใครในโรงอาหารมองตามเลยสักคน
    ตอนเดินผ่านประตู มีรุ่นน้องอีกคนเรียกเขาว่า "ปาล์ม" แล้วเขาก็พยักหน้ารับเฉยๆ
    ~ introduce("palm")
    เราได้ชื่อเขามาโดยที่ยังไม่ได้พูดกับเขาสักคำ
    -> DONE

=== after ===
รอบๆ โต๊ะนี้มีที่นั่งว่างอีกหกที่ ทั้งที่โรงอาหารเต็มไปหมด

+ ["พรุ่งนี้มานั่งตรงนี้อีกไหม"]
    ~ gainStat("kind", 1)
    ~ gainAffinity("palm", 2)
    ~ setFlag("meet_palm_again")
    "ผมนั่งตรงนี้ทุกวันครับ" เขาพูด แล้วก็รีบเติม "…แต่ถ้าพี่จะมาก็ได้"
    -> DONE

+ ["โรงเรียนเก่าอยู่ไหน"]
    ~ gainAffinity("palm", -1)
    ~ setFlag("meet_palm_cold")
    ~ feel("sad")
    เขาเงียบไปนานพอที่คำถามจะกลายเป็นอย่างอื่น
    "…ไกลครับ" แล้วก็ไม่พูดอะไรอีกเลยจนลุกจากโต๊ะ
    -> DONE

=== as_transfer ===
โต๊ะริมสุดมีคนนั่งอยู่คนเดียว ซึ่งเป็นภาพที่เราเพิ่งเห็นในกระจกเมื่อเช้านี้เอง
เขาเงยหน้าขึ้นมาแล้วก็ก้มลงเร็วมาก

+ ["ผมก็เพิ่งย้ายมาเหมือนกัน"]
    ~ gainStat("kind", 2)
    ~ gainAffinity("palm", 4)
    ~ setFlag("meet_palm_open")
    เขาเงยหน้าขึ้นมาอีกครั้ง คราวนี้ไม่ได้ก้มลงทันที
    ~ introduce("palm")
    "ปาล์มครับ" เขาบอกชื่อ "ผมมาตั้งแต่กลางเทอมที่แล้ว… ยังไม่ชินเลยครับ"
    "พี่ล่ะครับ ชินหรือยัง"
    -> after

+ [นั่งลงเงียบๆ]
    ~ setFlag("meet_palm_quiet")
    สองคนนั่งโต๊ะเดียวกันโดยไม่พูดอะไรเลยทั้งพักกลางวัน
    ซึ่งแปลกตรงที่ไม่มีใครรู้สึกอึดอัด
    ~ introduce("palm")
    "ปาล์มครับ" เขาพูดตอนลุก "…ขอบคุณครับ"
    -> after
