INCLUDE _shared.ink

// ปลายทางของเราเอง ตอนจบ ม.ปลาย — เล่นจากสิ่งที่เราทำ ไม่ใช่จากใครที่เราชอบ

ปิดเทอมสุดท้ายของปีนี้ ห้องเรียนว่างเร็วกว่าที่เคย

{
    - hasFlag("vow_study") && hasFlag("vow_live"):
        เราตั้งใจไว้ตั้งแต่วันแรกทั้งสองอย่าง — จะเรียนให้ดี และจะไม่พลาดอะไรอีก
        สองอย่างนี้แย่งเวลากันทั้งเทอม และเราก็ไม่ได้ทำได้ครบสักอย่าง
    - hasFlag("vow_study"):
        เราตั้งใจไว้ตั้งแต่วันแรกว่าจะเรียนให้ดี
    - hasFlag("vow_live"):
        เราตั้งใจไว้ตั้งแต่วันแรกว่าจะไม่พลาดอะไรอีก
    - else:
        เราไม่ได้ตั้งใจอะไรไว้เลยตอนต้นเทอม แล้วเทอมก็ผ่านไปแบบนั้นจริงๆ
}

{
    - homeworkMissed == 0:
        การบ้านทุกชิ้นของเทอมนี้ถูกส่ง ไม่มีใครรู้ นอกจากเราคนเดียว
    - homeworkMissed >= 12:
        มีงานที่ไม่ได้ส่งอยู่ {homeworkMissed} ชิ้น และครูจำได้ทุกชิ้น
    - else:
        มีงานที่ไม่ได้ส่งอยู่ {homeworkMissed} ชิ้น ซึ่งถือว่าปกติมากสำหรับคนทั่วไป
}

{
    - behaviour >= 95:
        คะแนนความประพฤติเหลือ {behaviour} จากร้อย
    - behaviour >= 70:
        คะแนนความประพฤติเหลือ {behaviour} จากร้อย ฝ่ายปกครองจำชื่อเราได้แล้ว
    - else:
        คะแนนความประพฤติเหลือ {behaviour} จากร้อย ปีหน้าเราขึ้นบัญชีจับตาแน่นอน
}

{
    - standingRank >= 4:
        ตอนนี้ทั้งโรงเรียนรู้จักเรา ซึ่งมีทั้งข้อดีและข้อเสียที่เรายังนับไม่ครบ
    - standingRank <= 1:
        ชื่อของเราในโรงเรียนนี้ยังพังอยู่ และปีหน้าก็ต้องเริ่มจากตรงนั้น
}

// สิ่งเล็กๆ ที่ไม่มีระบบไหนนับ แต่มันเกิดขึ้นจริง
{ hasFlag("wai_kru_helped"):
    ครูที่เราไปช่วยเก็บพานวันไหว้ครู ทักเราทุกครั้งที่เดินสวนกันตลอดทั้งปี
}
{ hasFlag("group_greeted"):
    คู่งานกลุ่มคาบนั้นกลายเป็นคนที่เราทักได้ตลอดเทอม ทั้งที่ไม่ได้สนิทกันเลย
}
{ hasFlag("sports_played"):
    เรายังเจ็บเข่าข้างซ้ายเวลาฝนตก และยังคิดว่าคุ้ม
}
{ hasFlag("sports_played_music"):
    คลิปที่เราขึ้นเล่นเปิดงานกีฬาสีถูกส่งต่อในกลุ่มห้องจนถึงเทอมหน้า
}
{ hasFlag("sports_medic"):
    หน่วยพยาบาลสนามขอชื่อเราไว้ ปีหน้าเขาเรียกเราก่อนใคร
}
{ hasFlag("sports_ice"):
    น้ำแข็งใสวันนั้นทั้งแถวยังพูดถึงอยู่ ทั้งที่จำคะแนนกีฬาสีไม่ได้แล้ว
}
{ hasFlag("camp_stars"):
    คืนที่เราแอบออกไปดูดาวหลังค่าย ไม่มีใครรู้จนถึงตอนนี้
}
{ hasFlag("trip_souvenir"):
    ของฝากจากทัศนศึกษายังอยู่บนโต๊ะที่บ้าน และยังไม่ได้ให้ใครสักคน
}
{ hasFlag("saw_empty_chairs"):
    เก้าอี้ว่างแถวหน้าในวันแม่ เรายังนึกถึงมันทุกครั้งที่ได้ยินเพลงนั้น
}
{ hasFlag("stared_back"):
    วันที่เรามองตากลับไปหน้าเสาธง เด็กทั้งแถวเห็น และจำได้นานกว่าที่เราคิด
}
{ hasFlag("ending_minta"):
    และเรายังเก็บภาพที่มินตราทำปากขยับว่า "ติดแล้ว" ไว้ได้ชัดกว่าทุกอย่างในเทอมนี้
}

{ hasFlag("caught_lying"):
    มีอยู่ครั้งหนึ่งที่เราพูดกับสองคนไม่ตรงกัน แล้วเขาสองคนคุยกัน
    ไม่มีใครโกรธเราออกมาตรงๆ แต่หลังจากนั้นเวลาเราพูดอะไร เขาจะเงียบไปหนึ่งจังหวะก่อนตอบ
}

{ hasFlag("board_top"):
    มีอยู่รอบหนึ่งที่ชื่อเราอยู่บนสุดของกระดานหน้าห้อง
    คนที่ไม่เคยทักเราเลยทั้งเทอมเดินมาถามว่าอ่านยังไง
}
{ hasFlag("board_bottom"):
    มีอยู่รอบหนึ่งที่ชื่อเราอยู่ท้ายกระดานหน้าห้อง
    กระดานติดอยู่ตรงนั้นทั้งสัปดาห์ และเราต้องเดินผ่านมันวันละสี่รอบ
}

{
    - hasFlag("milestone_won"):
    งานใหญ่ของชมรมปีนี้ มีคนถ่ายรูปไว้ แล้วรูปนั้นไปอยู่บนบอร์ดหน้าห้องพักครูจนจบเทอม
    - hasFlag("milestone_flopped"):
    งานใหญ่ของชมรมปีนี้ เราอยู่ในรูปหมู่ด้วย ยืนแถวหลังสุด
    ไม่มีใครพูดถึงมันอีก และนั่นคือสิ่งที่แย่ที่สุดของมัน
}

{ hasFlag("caught_with_other"):
    มีอยู่วันหนึ่งที่เราเดินเข้าห้องสมุดไปกับคนหนึ่ง แล้วเห็นอีกคนนั่งรออยู่ตรงโต๊ะเดิม
    เขาไม่ได้ลุกหนี ไม่ได้ทัก แค่ก้มลงอ่านหนังสือต่อเหมือนไม่เห็นเรา
}
{ hasFlag("gossip_spread"):
    บางเรื่องเราไม่เคยเล่าให้ใครฟังเลย แต่ทั้งห้องรู้ก่อนเราอีก
    คนที่เราปล่อยไว้นานที่สุดคือคนที่มีเพื่อนให้เล่ามากที่สุด
}

{
    - hasFlag("gave_home_full") && hasFlag("refused_home"):
    ปีนี้แม่โทรมาหลายรอบ บางรอบเราโอนให้ บางรอบเราบอกว่าไม่มีทั้งที่มี
    เราจำได้ทุกรอบว่ารอบไหนเป็นรอบไหน
    - hasFlag("gave_home_full"):
    เงินที่หาได้ปีนี้ไม่ได้อยู่กับเรา มันอยู่กับคนที่อยู่บ้าน
    ไม่มีใครที่โรงเรียนรู้เรื่องนี้เลยสักคน
    - hasFlag("gave_home_part"):
    มีรอบหนึ่งที่เราให้ไม่ครบ แม่รับไว้เหมือนครบ
    - hasFlag("refused_home"):
    มีรอบหนึ่งที่เราบอกว่าไม่มีทั้งที่มี และเราเป็นคนเดียวที่รู้
    - hasFlag("broke_at_home"):
    มีรอบหนึ่งที่เราไม่มีจริงๆ ซึ่งเจ็บคนละแบบกับการไม่ให้
}
{ hasFlag("helped_home"):
    ตอนปิดเทอมแม่ถามว่าอยากได้อะไรไหม เราบอกว่าไม่ต้อง
}

{ hasFlag("rival_ahead"):
    มีคนที่เราอยากสนิทด้วยแล้วมีคนอื่นไปถึงก่อน
    ไม่ใช่เพราะเขาดีกว่าเรา แต่เพราะเขาอยู่ตรงนั้นในวันที่เราไม่อยู่
}

{
    - hasFlag("perfect_gift") && hasFlag("wrong_gift"):
    ของฝากที่เราเลือกปีนี้มีทั้งที่เขายิ้มจริงๆ และที่เขารับไปแบบไม่รู้จะเอาไปทำอะไร
    เราจำได้ทั้งสองแบบ และจำได้ว่าต่างกันตรงไหน
    - hasFlag("perfect_gift"):
    มีของฝากชิ้นหนึ่งที่เราเลือกอยู่นาน แล้วเขาเก็บมันไว้จริงๆ
    - hasFlag("wrong_gift"):
    มีของฝากชิ้นหนึ่งที่เราซื้อเพราะมันแพง ไม่ใช่เพราะเขาอยากได้
    เขารับไปแล้วขอบคุณ แล้วเราก็ไม่เคยเห็นมันอีกเลย
}

ปีหน้าเริ่มอีกสี่สิบวัน

// สมุดปกแดง — สิ่งที่เราพูดในห้องประชุมวันนั้น คือสิ่งที่เทอมนี้ทั้งเทอมเดินไปหา
{
    - hasFlag("plot_teacher"):
        ~ feel("firm")
    ปีถัดมาโรงเรียนเปลี่ยนวิธีใช้สมุดประจำห้อง นักเรียนอ่านของตัวเองได้
    ไม่มีใครบอกว่าเปลี่ยนเพราะอะไร และไม่มีใครเอ่ยชื่อเราสักครั้ง
    แต่เรารู้ และอีกสองสามคนก็รู้
    - hasFlag("plot_blame"):
        ~ feel("sad")
    เราพูดความจริง และความจริงก็ทำงานของมัน
    สิ่งที่ไม่มีใครบอกเราคือความจริงไม่ได้เลือกว่าใครจะเจ็บ
    - hasFlag("plot_self"):
        ~ feel("sad")
    ชื่อเราอยู่ในสมุดเล่มนั้นตั้งแต่วันนั้น ด้วยเรื่องที่เราไม่ได้ทำ
    เราเลือกเอง ซึ่งทำให้มันต่างจากของคนอื่นที่อยู่ในนั้นโดยไม่ได้เลือก
    - hasFlag("plot_silent"):
        ~ feel("away")
    เรานั่งอยู่ในห้องนั้นจนจบโดยไม่พูดอะไร
    หลายปีต่อมาเรายังจำได้ว่าเก้าอี้ตัวนั้นเย็นแค่ไหน
    - else:
    เทอมนั้นมีสมุดเล่มหนึ่งที่ตัดสินคนไปหลายคน และเราไม่เคยได้เข้าไปเกี่ยวข้องกับมันเลย
}

// ทางเล็กๆ ระหว่างทางของเรื่องหลัก — คนละเรื่องกับ *สิ่งที่เราพูดในห้องประชุม*
// นี่คือ *วิธีที่เราเดินมาถึงตรงนั้น* ซึ่งเป็นคนละอย่างกันและควรถูกจำคนละแบบ
{
    - hasFlag("mp_sharp"):
    คำถามที่เราถามในทางเดินเช้าวันนั้น — ใครเป็นคนตัดสินว่าอะไรควรถูกจด —
    มีรุ่นน้องเอาไปถามต่อในปีถัดมา และถามในที่ที่ดังกว่าทางเดิน
    - hasFlag("mp_asked"):
    "แล้วถ้าจดผิดล่ะ" เป็นคำถามที่เราถามตั้งแต่สัปดาห์แรก
    ตอนนั้นไม่มีใครตอบ แล้วอีกเจ็ดสัปดาห์ต่อมาเราก็ได้คำตอบเอง
    - hasFlag("mp_shrug"):
    "ก็แค่ทำตัวดีๆ ก็จบ" เราเคยพูดแบบนั้นจริงๆ ในสัปดาห์แรก
    และเราก็ยังจำได้ว่าพูดด้วยน้ำเสียงแบบไหน
}
{
    - hasFlag("mp_saw_back"):
    เช้าวันนั้นเรามองไปที่ท้ายแถว และเห็นคนที่รู้อยู่แล้วว่าชื่อตัวเองอยู่ในสมุด
    เราเห็นเขาก่อนที่เขาจะกลายเป็นเรื่องของเรา
    - hasFlag("mp_saw_head"):
    เช้าวันนั้นเรามองไปที่หัวหน้าห้อง และเห็นหน้านิ่งแบบคนที่กำลังคิดอย่างอื่นอยู่
    ตอนนั้นเราไม่รู้ว่าเธอคิดเรื่องอะไร
}
{
    - hasFlag("mp_pushed_back"):
    ตอนถูกเรียกไปถามครั้งแรก เราถามกลับว่าทำไมต้องเป็นเรา
    ครูตอบว่า "ใช่" แล้วก็ขอโทษ ซึ่งไม่มีครูคนไหนเคยทำแบบนั้นกับเรามาก่อน
    - hasFlag("mp_told_truth"):
    ตอนถูกเรียกไปถามครั้งแรก เราตอบไปตรงๆ ทั้งหมด ไม่เติมและไม่ตัด
    ครูบอกว่าคำตอบที่สั้นที่สุดมักจะจริงที่สุด และเขาก็จำคำตอบนั้นได้จนถึงวันประชุม
    - hasFlag("mp_denied"):
    ตอนถูกเรียกไปถามครั้งแรก เราปฏิเสธก่อนที่จะมีใครกล่าวหา
    ครูจดอะไรสักอย่างลงไป และเราไม่เคยได้รู้เลยว่าเขาจดว่าอะไร
}
{ hasFlag("mp_teacher_hint"):
    "อย่าบอกครู บอกกรรมการ" — ครูประจำชั้นพูดประโยคนั้นกับเราเพียงครั้งเดียว
    แล้วก็ไม่เคยพูดถึงมันอีกเลยทั้งปี
}
{ hasFlag("mp_teacher_regret"):
    ครูเล่าให้ฟังว่าปีที่แล้วเขาไม่ได้บอกใคร แล้วเด็กคนนั้นก็ไม่ได้เรียนต่อ
    เขาเล่าเรื่องนั้นครั้งเดียว และเล่าเหมือนคนที่ซ้อมมานานแล้วว่าจะเล่ายังไง
}

-> DONE
