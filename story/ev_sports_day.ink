INCLUDE _shared.ink
-> start
=== start ===
กีฬาสี อัฒจันทร์แบ่งเป็นสี่สี เชียร์ลีดเดอร์ซ้อมกันมาสามสัปดาห์
สีของห้องเราคือสีเขียว ซึ่งปีที่แล้วได้ที่สี่จากสี่
เสียงกลองจากอัฒจันทร์ฝั่งตรงข้ามดังจนพื้นสั่น
{
    - club == "sport":
        + [ลงแข่งเต็มที่]
            ~ gainStat("heart", 5)
            ~ gainStat("nerve", 3)
            ~ setFlag("sports_played")
            วิ่งผลัดไม้สุดท้าย แซงได้หนึ่งคนตอนโค้งสุดท้าย
            ได้ที่สาม แต่ทั้งอัฒจันทร์เขียวลุกขึ้นยืน
            -> DONE
    - club == "music":
        + [ขึ้นเล่นเปิดงาน]
            ~ gainStat("charm", 5)
            ~ gainAffinity("minta", 3)
            ~ setFlag("sports_played_music")
            เครื่องเสียงหอนสองครั้งก่อนจะเข้าที่
            เล่นจบแล้วมีคนตะโกนชื่อวงจากอัฒจันทร์สีอื่นด้วย
            -> DONE
    - else:
        + [ไปช่วยหน่วยพยาบาลสนาม]
            ~ gainStat("kind", 4)
            ~ setFlag("sports_medic")
            พันผ้าให้คนข้อเท้าพลิกสี่คน และส่งน้ำให้อีกนับไม่ถ้วน
            ไม่มีใครจำชื่อเรา แต่มีคนมาขอบคุณสิบเจ็ดครั้ง
            -> DONE
}
+ [นั่งเชียร์อยู่บนอัฒจันทร์จนจบวัน]
    ~ gainStat("charm", 2)
    ~ gainStat("kind", 1)
    เสียงแหบไปสามวัน คุ้มอยู่
    -> DONE
+ {nerve >= 18} [แอบออกไปซื้อน้ำแข็งใสให้ทั้งแถว]
    ~ gainStat("nerve", 3)
    ~ gainStat("charm", 3)
    ~ setFlag("sports_ice")
    ปีนรั้วออกไปหน้าโรงเรียนตอนพักครึ่ง กลับมาพร้อมถุงน้ำแข็งใสสิบสองถุง
    วันนั้นทั้งอัฒจันทร์เขียวรู้จักชื่อเรา
    -> DONE
